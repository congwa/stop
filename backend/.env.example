# !! 生产环境请修改以下所有值 !!

# JWT 签名密钥（至少 32 位随机字符串）
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars

# 管理后台私钥（登录时输入，换取 JWT token）
ADMIN_PASSWORD=wangcong0921!

# 静态 Admin Token（开发兼容，生产建议留空或删除）
ADMIN_TOKEN=dev-admin-token-change-in-production

# 数据库路径
DATABASE_URL=sqlite:///./data/stop_license.db

# 服务端口
PORT=17771
HOST=0.0.0.0

# KEY 过期日期基准（YYYY-MM-DD）
KEY_EPOCH_DATE=2025-01-01
